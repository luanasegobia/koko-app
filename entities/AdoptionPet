{
  "name": "AdoptionPet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la mascota"
    },
    "species": {
      "type": "string",
      "enum": [
        "perro",
        "gato",
        "otro"
      ],
      "description": "Especie"
    },
    "breed": {
      "type": "string",
      "description": "Raza"
    },
    "age_years": {
      "type": "number",
      "description": "Edad estimada en a\u00f1os"
    },
    "sex": {
      "type": "string",
      "enum": [
        "macho",
        "hembra"
      ],
      "description": "Sexo"
    },
    "size": {
      "type": "string",
      "enum": [
        "peque\u00f1o",
        "mediano",
        "grande"
      ],
      "description": "Tama\u00f1o"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n y temperamento"
    },
    "vaccinated": {
      "type": "boolean",
      "description": "\u00bfEst\u00e1 vacunado?"
    },
    "sterilized": {
      "type": "boolean",
      "description": "\u00bfEst\u00e1 esterilizado?"
    },
    "contact_name": {
      "type": "string",
      "description": "Nombre del contacto"
    },
    "contact_phone": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto"
    },
    "location": {
      "type": "string",
      "description": "Ubicaci\u00f3n / barrio"
    },
    "status": {
      "type": "string",
      "enum": [
        "disponible",
        "en_proceso",
        "adoptado"
      ],
      "default": "disponible"
    }
  },
  "required": [
    "name",
    "species"
  ],
  "rls": {
    "create": {},
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}