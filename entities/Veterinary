{
  "name": "Veterinary",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la veterinaria"
    },
    "address": {
      "type": "string",
      "description": "Direcci\u00f3n"
    },
    "phone": {
      "type": "string",
      "description": "Tel\u00e9fono"
    },
    "lat": {
      "type": "number",
      "description": "Latitud"
    },
    "lng": {
      "type": "number",
      "description": "Longitud"
    },
    "is_emergency": {
      "type": "boolean",
      "description": "\u00bfEs de emergencia 24h?"
    },
    "schedule": {
      "type": "array",
      "description": "Horarios por d\u00eda",
      "items": {
        "type": "object",
        "properties": {
          "day": {
            "type": "string",
            "enum": [
              "lunes",
              "martes",
              "mi\u00e9rcoles",
              "jueves",
              "viernes",
              "s\u00e1bado",
              "domingo"
            ]
          },
          "open": {
            "type": "string",
            "description": "Hora de apertura (HH:mm)"
          },
          "close": {
            "type": "string",
            "description": "Hora de cierre (HH:mm)"
          }
        }
      }
    },
    "services": {
      "type": "string",
      "description": "Servicios que brinda la veterinaria"
    },
    "bio": {
      "type": "string",
      "description": "Descripci\u00f3n / presentaci\u00f3n"
    },
    "is_verified": {
      "type": "boolean",
      "description": "\u00bfVerificada por el administrador?",
      "default": false
    },
    "registered_by_user_id": {
      "type": "string",
      "description": "ID del usuario veterinario que se registr\u00f3"
    }
  },
  "required": [
    "name",
    "address",
    "phone"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.is_verified": true
        },
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}