{
  "name": "Pet",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nombre de la mascota"
    },
    "species": {
      "type": "string",
      "enum": [
        "perro",
        "gato",
        "otro"
      ],
      "description": "Especie"
    },
    "breed": {
      "type": "string",
      "description": "Raza"
    },
    "age_years": {
      "type": "number",
      "description": "Edad en a\u00f1os"
    },
    "sex": {
      "type": "string",
      "enum": [
        "macho",
        "hembra"
      ],
      "description": "Sexo"
    },
    "photo_url": {
      "type": "string",
      "description": "URL de la foto"
    },
    "description": {
      "type": "string",
      "description": "Descripci\u00f3n"
    },
    "allergies": {
      "type": "string",
      "description": "Alergias conocidas"
    },
    "owner_name": {
      "type": "string",
      "description": "Nombre del due\u00f1o"
    },
    "owner_phone": {
      "type": "string",
      "description": "Tel\u00e9fono del due\u00f1o"
    },
    "owner_whatsapp": {
      "type": "string",
      "description": "WhatsApp del due\u00f1o"
    },
    "qr_id": {
      "type": "string",
      "description": "ID \u00fanico para QR/NFC"
    }
  },
  "required": [
    "name",
    "species"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}