# Variables de entorno: .env.local es personal de cada máquina y nunca se sube.
# .env.example sí se versiona: es la plantilla que copia cada persona del equipo.
.env
.env.*
!.env.example
*.local

# Generado por scripts/generar-entorno.mjs a partir de .env.local
src/environments/entorno.local.ts

# Compilado
/www
/dist
/out-tsc
/tmp
/bazel-out

# Capacitor (plataformas nativas, se generan con npx cap add)
/android
/ios

# Node
/node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Editores
.vscode/*
!.vscode/extensions.json
.idea
.project
.classpath
.settings/
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.history/*

# Configuración personal de Claude Code: launch.json sí se versiona
.claude/settings.local.json

# Varios
/.angular/cache
.sass-cache/
/coverage
/connect.lock
/libpeerconnection.log
testem.log
/typings
__screenshots__/
.DS_Store
Thumbs.db
