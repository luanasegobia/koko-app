# Copiá este archivo a .env.local y completá los valores.
# .env.local NO se sube al repositorio: es personal de cada máquina.
#
#   cp .env.example .env.local      (en Windows: copy .env.example .env.local)
#
# Ojo: Vite lee estos archivos solo al arrancar. Si los cambiás, reiniciá `npm run dev`.

# --- Supabase (obligatorias) -------------------------------------------------
# Las dos salen del panel del proyecto compartido de desarrollo:
#   Project Settings → API
# Si no tenés acceso, pedíselas a alguien del equipo.
VITE_SUPABASE_URL=https://knvocftylpunbzycoarx.supabase.co

# Usá la clave "anon public" (o "publishable").
# NUNCA la "service_role" ni una que empiece con sb_secret_: esas saltean todas
# las políticas de seguridad y dejarían la base compartida abierta para cualquiera.
VITE_SUPABASE_ANON_KEY=

# --- Stripe (opcional) -------------------------------------------------------
# Las donaciones con tarjeta están fuera de alcance por ahora. Si dejás esta
# variable vacía la app funciona igual: el botón queda deshabilitado y las
# donaciones por alias siguen andando.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- Funciones en desarrollo (opcionales) ------------------------------------
# Ambas están apagadas por defecto. Poné "true" solo si estás trabajando
# puntualmente en esa función.
#
# Chat y notificaciones en vivo. La traducción de eventos ya está hecha y
# testeada, pero enciende suscripciones que nunca llegaron a ejecutarse.
VITE_HABILITAR_TIEMPO_REAL=
#
# Alertas por cercanía. Sondea la base cada 30 segundos y escribe
# notificaciones, por cada pestaña abierta.
VITE_HABILITAR_ALERTAS=
